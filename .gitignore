# Godot 4+ specific ignores
.godot/
/android/

# Export output
/build/
*.apk
*.aab
*.ipa

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp

# Godot API dumps (local reference only)
extension_api.json

# Files written by tests and e2e scripts (StoragePaths.SANDBOX_DIR)
.test_saves/

# Signing keys (never commit)
*.keystore
*.jks

# Road builder checkpoint (tools/road_builder.gd --resume)
.road_checkpoint.json
