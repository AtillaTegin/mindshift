size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("icon_view")

[node name="CoinLabel" type="Label" parent="Margin/Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CoinLabel"
