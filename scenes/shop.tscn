[node name="TopBar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/Layout/TopBar"]
script = ExtResource("pb_polished")
